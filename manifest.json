{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "version": "0.2.0",
  "description": "__MSG_description__",
  "default_locale": "en",
  "minimum_chrome_version": "121",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "scripting",
    "activeTab",
    "contextMenus",
    "notifications",
    "alarms",
    "offscreen",
    "clipboardWrite"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "incognito": "not_allowed",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "commands": {
    "history-back": {
      "description": "__MSG_cmd_history_back__",
      "suggested_key": {
        "default": "Ctrl+Comma",
        "mac": "MacCtrl+Comma"
      }
    },
    "history-forward": {
      "description": "__MSG_cmd_history_forward__",
      "suggested_key": {
        "default": "Ctrl+Period",
        "mac": "MacCtrl+Period"
      }
    },
    "switch-previous-tab": {
      "description": "__MSG_cmd_switch_previous_tab__"
    },
    "close-right": {
      "description": "__MSG_cmd_close_right__"
    },
    "move-tab-left": {
      "description": "__MSG_cmd_move_tab_left__"
    },
    "move-tab-right": {
      "description": "__MSG_cmd_move_tab_right__"
    },
    "move-tab-first": {
      "description": "__MSG_cmd_move_tab_first__"
    },
    "move-tab-last": {
      "description": "__MSG_cmd_move_tab_last__"
    },
    "move-to-new-window": {
      "description": "__MSG_cmd_move_to_new_window__"
    },
    "move-with-left-to-new-window": {
      "description": "__MSG_cmd_move_with_left_to_new_window__"
    },
    "move-with-right-to-new-window": {
      "description": "__MSG_cmd_move_with_right_to_new_window__"
    },
    "duplicate-tab": {
      "description": "__MSG_cmd_duplicate_tab__"
    },
    "copy-links": {
      "description": "__MSG_cmd_copy_links__"
    },
    "copy-links-markdown": {
      "description": "__MSG_cmd_copy_links_markdown__"
    },
    "go-to-chatgpt": {
      "description": "__MSG_cmd_go_to_chatgpt__"
    },
    "send-chatgpt": {
      "description": "__MSG_cmd_send_chatgpt__"
    },
    "go-to-claude": {
      "description": "__MSG_cmd_go_to_claude__"
    },
    "send-claude": {
      "description": "__MSG_cmd_send_claude__"
    },
    "go-to-default-target": {
      "description": "__MSG_cmd_go_to_default_target__"
    },
    "send-default-target": {
      "description": "__MSG_cmd_send_default_target__"
    }
  }
}
